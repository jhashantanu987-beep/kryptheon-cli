{
  "name": "kryptheon",
  "version": "0.1.9",
  "description": "Record what you do in your app and get plain-language reports when it breaks.",
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "kryptheon": "bin/kryptheon.js"
  },
  "exports": {
    ".": "./kryptheon-fixture.js",
    "./kryptheon-fixture": "./kryptheon-fixture.js",
    "./kryptheon-reporter": "./kryptheon-reporter.js",
    "./package.json": "./package.json",
    "./kryptheon-replay": "./kryptheon-replay.js",
    "./kryptheon-signature": "./kryptheon-signature.js",
    "./kryptheon-secrets": "./kryptheon-secrets.js"
  },
  "files": [
    "bin/",
    "kryptheon-fixture.js",
    "kryptheon-reporter.js",
    "kryptheon-signature.js",
    "kryptheon-secrets.js",
    "playwright.config.js",
    "README.md",
    "kryptheon-replay.js",
    "kryptheon-selectors.js",
    "kryptheon-recordings.js",
    "kryptheon-cleanup.js"
  ],
  "engines": {
    "node": ">=20.6.0"
  },
  "dependencies": {
    "@playwright/test": "^1.62.1"
  },
  "scripts": {
    "check": "node kryptheon-reporter.check.js && node kryptheon-signature.check.js && node kryptheon-signature.stream.check.js && node kryptheon-signature.baseline.check.js && node kryptheon-signature.settle.check.js && node kryptheon-signature.number.check.js && node kryptheon-step3.check.js && node kryptheon-watchdog.check.js && node kryptheon-record.check.js && node kryptheon-selectors.check.js && node kryptheon-recordings.check.js && node kryptheon-cleanup.check.js && node kryptheon-package.check.js",
    "check:stream": "node kryptheon-signature.stream.check.js",
    "check:baseline": "node kryptheon-signature.baseline.check.js",
    "check:settle": "node kryptheon-signature.settle.check.js",
    "check:step3": "node kryptheon-step3.check.js",
    "check:watchdog": "node kryptheon-watchdog.check.js",
    "check:record": "node kryptheon-record.check.js",
    "check:package": "node kryptheon-package.check.js",
    "prepublishOnly": "node kryptheon-package.check.js",
    "check:selectors": "node kryptheon-selectors.check.js",
    "check:number": "node kryptheon-signature.number.check.js",
    "check:recordings": "node kryptheon-recordings.check.js",
    "check:cleanup": "node kryptheon-cleanup.check.js"
  },
  "keywords": [
    "playwright",
    "testing",
    "end-to-end",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhashantanu987-beep/kryptheon-cli.git"
  },
  "bugs": {
    "url": "https://github.com/jhashantanu987-beep/kryptheon-cli/issues"
  },
  "homepage": "https://github.com/jhashantanu987-beep/kryptheon-cli#readme"
}
